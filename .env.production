# ===== APP CONFIGURATION =====
NEXT_PUBLIC_APP_URL=https://kikwetuconnect.vercel.app
NEXT_PUBLIC_APP_NAME=KikwetuConnect
NODE_ENV=production

# ===== OPTIONAL: OAuth Providers =====
# Google OAuth (https://console.cloud.google.com)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Apple OAuth (https://developer.apple.com)
NEXT_PUBLIC_APPLE_CLIENT_ID=your_apple_client_id
APPLE_CLIENT_SECRET=your_apple_client_secret

# ===== OPTIONAL: Translation & AI =====
# Google Translate API (https://cloud.google.com/translate)
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key

# OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key

# ===== OPTIONAL: Analytics & Monitoring =====
# Sentry (https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn

# PostHog (https://posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key

# ===== DATABASE REPLICATION =====
# Enable connection pooling for better resource usage
DATABASE_POOL_SIZE=20
DATABASE_IDLE_TIMEOUT=900

# ===== VERCEL SPECIFIC =====
VERCEL_ENV=production
VERCEL_URL=kikwetuconnect.vercel.app

# ===== CORS & SECURITY =====
NEXT_PUBLIC_ALLOWED_ORIGINS=https://kikwetuconnect.vercel.app,https://kikwetuconnect.com

# ===== CACHING =====
REVALIDATE_FEED=3600
REVALIDATE_POSTS=1800
REVALIDATE_TOPICS=86400
