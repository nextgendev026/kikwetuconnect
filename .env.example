# Copy to .env.local (and .env.vercel for Vercel CLI imports).
# All keys shown here are PUBLIC client keys except SUPABASE_SERVICE_ROLE_KEY
# and VAPID_PRIVATE_KEY, which are SECRET and must never leak to the browser.

# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase anon/public key (public, safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Supabase service role key (SECRET - server only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Deployed app URL (public)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_NAME=KikwetuConnect

# Web Push (VAPID) keys - public + secret
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# --- Import into Vercel ---
# CLI:  vercel env pull  (pull from existing project)
#       vercel env add NEXT_PUBLIC_SUPABASE_URL production
#       vercel --prod
# Dashboard: Project -> Settings -> Environment Variables -> paste from .env.vercel
